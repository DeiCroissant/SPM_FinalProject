<%- include('partials/header') %>
<section class="page-width admin-page"><%- include('partials/catalogue-nav') %>
<div class="page-heading"><div><h1><%= editing ? 'Edit book' : 'Add a book' %></h1><p>All fields are required. Use a public http or https URL for the cover.</p></div><a href="/admin/books" class="button button-outline">Back to books</a></div>
<% if (!authors.length || !categories.length) { %><div class="notice" role="status">Add at least one <a class="text-link" href="/admin/authors">author</a> and <a class="text-link" href="/admin/categories">category</a> before saving a book.</div><% } %>
<% if(Object.keys(errors).length) { %><div class="notice" role="alert">The book was not saved. Check the fields below.</div><% } %>
<form class="book-form" method="post" action="/admin/books<%= editing ? '/' + editing : '' %>" data-catalogue-form>
<input type="hidden" name="_csrf" value="<%= csrf %>">
<% for(const [key,label] of [['title','Title'],['author_id','Author'],['category_id','Category'],['price','Price (VND)'],['stock','Stock'],['cover_url','Cover image URL'],['description','Description']]) { %>
<div class="field <%= key === 'description' ? 'field-wide' : '' %>"><label for="book-<%= key %>"><%= label %></label>
<% if(key === 'author_id' || key === 'category_id') { const items=key==='author_id'?authors:categories; %>
<select id="book-<%= key %>" name="<%= key %>" required <%- errors[key] ? 'aria-invalid="true"' : '' %>><option value="">Choose <%= label.toLowerCase() %></option><% for(const item of items) { %><option value="<%= item.id %>" <%- values[key] === item.id ? 'selected' : '' %>><%= item.name %></option><% } %></select>
<% } else if(key === 'description') { %>
<textarea id="book-description" name="description" required maxlength="5000" rows="5" data-trim-required <%- errors[key] ? 'aria-invalid="true"' : '' %>><%= values[key] || '' %></textarea>
<% } else { %>
<input id="book-<%= key %>" name="<%= key %>" required type="<%= key === 'price' || key === 'stock' ? 'number' : key === 'cover_url' ? 'url' : 'text' %>" <%- key==='price' ? 'min="0.01" max="9999999999.99" step="0.01"' : key==='stock' ? 'min="0" max="2147483647" step="1"' : key==='title' ? 'maxlength="200" data-trim-required' : 'maxlength="2048" pattern="https?://.*"' %> value="<%= values[key] ?? '' %>" <%- errors[key] ? 'aria-invalid="true"' : '' %>>
<% } %><% if(errors[key]) { %><span class="field-error" role="alert"><%= errors[key] %></span><% } %></div><% } %>
<div class="field-wide form-actions"><button class="button" type="submit" <%- !authors.length || !categories.length ? 'disabled' : '' %>>Save book</button><a href="/admin/books" class="text-link">Cancel</a></div>
</form></section><%- include('partials/footer') %>
