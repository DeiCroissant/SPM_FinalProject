<%- include('partials/header') %>
<section class="page-width admin-page"><%- include('partials/catalogue-nav') %>
<div class="page-heading"><div><h1>Book management</h1><p>Update your catalogue. Hidden books stay in your records.</p></div><a class="button" href="/admin/books/new">Add a book +</a></div>
<% if(message) { %><div class="notice notice-success" role="status"><%= message %></div><% } %>
<div class="table-shell"><table><caption class="sr-only">Catalogue books, including hidden records</caption><thead><tr><th>Book / author</th><th>Category</th><th>Price / stock</th><th>Status</th><th>Actions</th></tr></thead><tbody>
<% for(const book of books) { %><tr><td><strong><%= book.title %></strong><span class="table-email"><%= book.author_name %></span></td><td><%= book.category_name %></td><td><%= Number(book.price).toLocaleString('en-US') %> VND<span class="table-email"><%= book.stock %> in stock</span></td><td><span class="status <%= Number(book.is_deleted) ? 'status-locked' : 'status-active' %>"><%= Number(book.is_deleted) ? 'Hidden' : 'Active' %></span></td><td><% if(!Number(book.is_deleted)) { %><div class="book-actions"><a class="button button-small button-outline" href="/admin/books/<%= book.id %>/edit">Edit<span class="sr-only"> <%= book.title %></span></a><form method="post" action="/admin/books/<%= book.id %>/hide"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button button-small button-outline" type="submit" data-confirm-hide>Hide<span class="sr-only"> <%= book.title %></span></button></form></div><% } else { %><span class="muted">Record retained</span><% } %></td></tr><% } %>
<% if(!books.length) { %><tr><td colspan="5">No books yet. Add an author and category, then create your first book.</td></tr><% } %>
</tbody></table></div></section><%- include('partials/footer') %>
