<%- include('partials/header') %>
<section class="page-width admin-page"><div class="page-heading"><div><a class="back-link" href="/">← Back to home</a><h1>Account management</h1><p>Create accounts and keep access in the right hands.</p></div><a class="button" href="#create-account">Create account <span aria-hidden="true">+</span></a></div>
  <% if (message) { %><div class="notice notice-success" role="status"><%= message %></div><% } %>
  <div class="table-shell"><table><caption class="sr-only">User accounts</caption><thead><tr><th scope="col">Name / email</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead><tbody>
  <% for (const account of users) { %><tr><td><strong><%= account.name %></strong><span class="table-email"><%= account.email %></span></td><td><%= account.role %><% if (account.id === user.id) { %><span class="you-label">You</span><% } %></td><td><span class="status <%= Number(account.is_locked) ? 'status-locked' : 'status-active' %>"><%= Number(account.is_locked) ? 'Locked' : 'Active' %></span></td><td><% if (account.id === user.id) { %><span class="muted">Current account</span><% } else { %><form method="post" action="/admin/users/<%= account.id %>/lock"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="<%= Number(account.is_locked) ? 'unlock' : 'lock' %>"><button type="submit" class="button button-small button-outline" aria-label="<%= Number(account.is_locked) ? 'Unlock' : 'Lock' %> <%= account.email %>"><%= Number(account.is_locked) ? 'Unlock' : 'Lock' %></button></form><% } %></td></tr><% } %>
  </tbody></table></div>
  <section id="create-account" class="create-section"><div><h2>Create an account</h2><p>Choose the access this person needs.<br>Your own account cannot be locked.</p></div><form method="post" action="/admin/users" data-validate class="create-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <% for (const [key, label, type] of [['name','Full name','text'],['email','Email address','email'],['password','Temporary password','password']]) { %><div class="field"><label for="create-<%= key %>"><%= label %></label><input id="create-<%= key %>" name="<%= key %>" type="<%= type %>" required <%- key === 'password' ? 'minlength="8" data-password-limit autocomplete="new-password"' : key === 'name' ? 'maxlength="100" autocomplete="off"' : 'maxlength="254" autocomplete="off"' %> value="<%= key === 'password' ? '' : values[key] || '' %>" <%- errors[key] ? 'aria-invalid="true"' : '' %>><% if (errors[key]) { %><span class="field-error" role="alert"><%= errors[key] %></span><% } %></div><% } %>
  <div class="field"><label for="create-role">Role</label><select id="create-role" name="role" required><option value="Customer" <%- values.role !== 'Administrator' ? 'selected' : '' %>>Customer</option><option value="Administrator" <%- values.role === 'Administrator' ? 'selected' : '' %>>Administrator</option></select><% if (errors.role) { %><span class="field-error"><%= errors.role %></span><% } %></div><button type="submit" class="button">Create account +</button></form></section>
</section>
<%- include('partials/footer') %>
