<%- include('partials/header') %>
<section class="page-width admin-page">
  <a class="back-link" href="<%= backUrl %>">← Back to list</a>
  <article class="book-detail">
    <img src="<%= book.cover_url %>" alt="Cover of <%= book.title %>" referrerpolicy="no-referrer" data-cover-fallback>
    <div>
      <p class="eyebrow"><%= book.category_name %></p>
      <h1><%= book.title %></h1>
      <p>By <%= book.author_name %></p>
      <p class="book-price"><%= Number(book.price).toLocaleString('en-US') %> VND</p>
      <% if (Number(book.stock) === 0) { %>
        <p><span class="book-out-of-stock">Out of Stock</span></p>
      <% } else { %>
        <p><%= book.stock %> in stock</p>
      <% } %>
      <p class="book-description"><%= book.description %></p>
    </div>
  </article>
</section>
<%- include('partials/footer') %>
