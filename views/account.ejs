<%- include('partials/header') %>
<section class="page-width account-page"><a class="back-link" href="/">← Back to home</a><h1>Hello, <%= user.name %>.</h1><p class="lead">Welcome to your corner of Le Bookstore.</p><dl class="account-details"><div><dt>Full name</dt><dd><%= user.name %></dd></div><div><dt>Email address</dt><dd><%= user.email %></dd></div><div><dt>Account role</dt><dd><%= user.role %></dd></div><div><dt>Status</dt><dd><span class="status status-active">Active</span></dd></div></dl><% if (user.role === 'Administrator') { %><a class="button" href="/admin/users">Manage accounts ↗</a><% } %></section>
<%- include('partials/footer') %>
