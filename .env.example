# npm run setup generates a local .env with random secrets/passwords.
PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional locally; REQUIRED on Vercel/production. Use a PostgreSQL connection string.
DATABASE_URL=
SQLITE_PATH=data/bookstore.sqlite
ADMIN_EMAIL=admin@lebookstore.local
ADMIN_PASSWORD=
CUSTOMER_EMAIL=customer@lebookstore.local
CUSTOMER_PASSWORD=
